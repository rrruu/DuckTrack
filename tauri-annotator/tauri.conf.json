{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckTrack Annotator",
  "version": "0.1.0",
  "identifier": "com.ducktrack.annotator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost blob: data:; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "DuckTrack — 动作标注",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ]
  }
}

